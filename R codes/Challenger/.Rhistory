library(sn)
library(knitr)
indicator = vector()
n <- 100
mu0 <- 0
for(i in 1:10000){
# Simulated data
set.seed(i)
data.sim <- rnorm(n,0,1)
# LRT Test statistic
barx = mean(data.sim)
LRT <- -n*log( 1/( 1 + n*(barx-mu0)^2/sum((data.sim-barx)^2) ))
# 0.95 Quantile of a t distribution with n-1 d.f.
q <- qchisq(0.95, df = 1)
# Outcome from the test
indicator[i] <- ifelse(LRT > q, 1, 0)
}
# Approximate size
mean(indicator)
