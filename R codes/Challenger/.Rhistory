# Required packages
library(sn)
library(knitr)
indicator = vector()
n <- 100
mu0 <- 1
for(i in 1:1000){
# Simulated data
set.seed(i)
data.sim <- rpois(n,1)
# LR test statistic
LRT <- abs(mean(data.sim) - mu0)/sqrt(var(data.sim)/n)
# 0.975 Quantile of a t distribution with n-1 d.f.
q <- qchisq(0.95, df = n-1)
# Outcome from the test
indicator[i] <- ifelse(LRT > q, 1, 0)
}
# Approximate size
mean(indicator)
