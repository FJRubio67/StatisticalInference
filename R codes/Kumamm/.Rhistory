#--------------------------------
# Example 3
#--------------------------------
a0 <- 5
b0 <- 3
ns <- 100
theta <- vector()
for(i in 1:1000){
# Simulation of Kumaraswamy distributed data
set.seed(i)
dat <- (rbeta(ns, shape1 = 1, shape2 = b0))^(1/a0)
# MME
theta[i]=MME(dat)
}
theta
#--------------------------------
# Example 3
#--------------------------------
a0 <- 5
b0 <- 3
ns <- 100
theta = matrix(0,nrow = 1000, ncol = 2)
for(i in 1:1000){
# Simulation of Kumaraswamy distributed data
set.seed(i)
dat <- (rbeta(ns, shape1 = 1, shape2 = b0))^(1/a0)
# MME
theta[i,]=MME(dat)
}
theta
colMeans(theta)
hist(theta[,1])
hist(theta[,2])
