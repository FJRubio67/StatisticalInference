library(mvtnorm)
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
X <- rmvnorm(n = 100, mean = rep(0, d), sigma = RHO)
d <- 3
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
X <- rmvnorm(n = 100, mean = rep(0, d), sigma = RHO)
X
# dimension
d <- 3
# number of simulations
n <- 10
# Correlation matrix
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
# Simulation (each row is a simulated vector)
X <- rmvnorm(n = n, mean = rep(0, d), sigma = RHO)
X
library(mvtnorm)
library(knitr)
# dimension
d <- 3
# number of simulations
n <- 10
# Correlation matrix
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
# Simulation (each row is a simulated vector)
X <- rmvnorm(n = n, mean = rep(0, d), sigma = RHO)
kable(X, digits = 3)
?kable
colnames(X) <- 1:d
rownames(X) <- 1:n
kable(X, digits = 3)
rowMeans(X)
cor(X)
rm(list=ls())
# Required packages
library(mvtnorm)
library(knitr)
# dimension
d <- 3
# number of simulations
n <- 100
# Correlation matrix
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
# Simulation (each row is a simulated vector)
set.seed(123) # seed
X <- rmvnorm(n = n, mean = rep(0, d), sigma = RHO)
# sample mean and sample correlation matrix
rowMeans(X)
cor(X)
colMeans(X)
cor(X)
print(RHO)
# number of simulations
n <- 1000
# Correlation matrix
RHO <- rbind(c(1,0.5,0.75), c(0.5,1,0.25), c(0.75,0.25,1))
print(RHO)
# Simulation (each row is a simulated vector)
set.seed(123) # seed
X <- rmvnorm(n = n, mean = rep(0, d), sigma = RHO)
# sample mean and sample correlation matrix
colMeans(X)
cor(X)
?diagnoal
?diagonal
ones
ones(3)
matrix(1, nrow = d, ncol = d)
matrix(1, nrow = d, ncol = d) - diag(d)
rho0 <- -0.5
RHO <- diagonal(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
det(RHO)
rho0 <- -0.5
RHO <- diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
det(RHO)
# dimension
d <- 3
# Correlation matrix
rho0 <- -0.49
RHO <- diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
det(RHO)
1/9
# dimension
d <- 10
# Correlation matrix
rho0 <- -0.25
RHO <- diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
# Determinant is zero!
det(RHO)
# dimension
d <- 10
# Correlation matrix
rho0 <- -0.1
RHO <- diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
# Determinant is positive
det(RHO)
d <- 3
# Correlation matrix
rho0 <- -0.5
RHO <- diag(d) + rho0*(matrix(1, nrow = d, ncol = d) - diag(d))
print(RHO)
# Determinant is zero!
det(RHO)
# So, if you try to use this correlation matrix on rmvnorm:
set.seed(123) # seed
X <- rmvnorm(n = n, mean = rep(0, d), sigma = RHO)
X
